#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "ninja_turtle"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "ninja_turtle" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "steer_fl_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "steer_fr_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "steer_rl_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "steer_rr_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "drive_fl_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "drive_fr_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "drive_rl_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "drive_rr_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint3" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint4" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint5" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper_right_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper_left_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "base_footprint" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "steer_fl_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "wheel_fl_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "steer_fr_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "wheel_fr_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "steer_rl_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "wheel_rl_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "steer_rr_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "wheel_rr_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "link2" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "link3" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "link4" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "link5" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "wrist_link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "gripper_right_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }

                                over "gripper_left_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

