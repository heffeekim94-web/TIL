        def PhysicsPrismaticJoint "gripper_right_joint" (
            prepend apiSchemas = ["NewtonJointAPI", "NewtonMimicAPI", "PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
        )
        {
            float drive:linear:physics:maxForce = 1
            uniform token drive:linear:physics:type = "force"
            rel newton:mimicJoint = </ninja_turtle/Physics/gripper_left_joint>
            float newton:velocityLimit = 4.8
            uniform token physics:axis = "X"
            custom rel physics:body0
            append rel physics:body0 = </ninja_turtle/Geometry/base_footprint/link2/link3/link4/link5/wrist_link>
            custom rel physics:body1
            append rel physics:body1 = </ninja_turtle/Geometry/base_footprint/link2/link3/link4/link5/wrist_link/gripper_right_link>
            point3f physics:localPos0 = (0.01202175, -0.037138384, -0.046160694)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.534496, 0, -0.000023291248, -0.84517103)
            quatf physics:localRot1 = (0.534496, 0, -0.000023291248, -0.84517103)
            float physics:lowerLimit = -0.003
            float physics:upperLimit = 0.0175
            custom float urdf:limit:effort = 1
        }

