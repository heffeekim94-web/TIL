#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "ninja_turtle"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "ninja_turtle"
{
    over "Physics"
    {
        over "steer_fl_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "drive_fl_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "steer_fr_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
