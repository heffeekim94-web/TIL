<mxCell id="p0_c14" value="내부 [0] = Y/tilt (ID12),  [1] = X/pan (ID11)&lt;br&gt;(입력 X,Y 순서와 반대)" style="whiteSpace=wrap;html=1;fontSize=12.5;fillColor=#fdf3f2;strokeColor=#b85450;rounded=0;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="230" y="1087" width="610" height="62" as="geometry"/></mxCell>
