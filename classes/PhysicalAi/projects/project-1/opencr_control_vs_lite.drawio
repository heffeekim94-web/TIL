<mxCell id="p2_C6y" value="prepareAxis() × 2&lt;br&gt;현재 위치로 Goal&lt;br&gt;torque ON&lt;br&gt;watchdog 500ms" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;rounded=0;" vertex="1" parent="1"><mxGeometry x="490" y="530" width="210" height="86" as="geometry"/></mxCell>
