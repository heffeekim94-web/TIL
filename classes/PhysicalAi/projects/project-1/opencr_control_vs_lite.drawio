<mxCell id="p0_r12" value="입력 버퍼" style="whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="951" width="200" height="62" as="geometry"/></mxCell>
<mxCell id="p0_c12" value="80자 · 루프당 ≤32자 · &#x27;x&#x27;는 줄바꿈 없이 즉시 정지&lt;br&gt;백스페이스 지원, 앞뒤 공백 제거" style="whiteSpace=wrap;html=1;fontSize=12.5;fillColor=#fdf3f2;strokeColor=#b85450;rounded=0;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="230" y="951" width="610" height="62" as="geometry"/></mxCell>
