<mxCell id="p0_r10" value="저장 (EEPROM)" style="whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="815" width="200" height="62" as="geometry"/></mxCell>
<mxCell id="p0_c10" value="auto_home 설정, 마지막 정지 위치 (체크섬 포함)&lt;br&gt;x · 이동 완료 시 저장" style="whiteSpace=wrap;html=1;fontSize=12.5;fillColor=#fdf3f2;strokeColor=#b85450;rounded=0;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="230" y="815" width="610" height="62" as="geometry"/></mxCell>
