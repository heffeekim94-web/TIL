<mxCell id="p1_R4" value="faulted ||&lt;br&gt;10ms 미경과?" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;rhombus;" vertex="1" parent="1"><mxGeometry x="910" y="380" width="300" height="76" as="geometry"/></mxCell>
<mxCell id="p1_R4y" value="return" style="whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="1300" y="398" width="120" height="40" as="geometry"/></mxCell>
<mxCell id="p1_R5" value="readPosition()&lt;br&gt;① SyncRead 132  위치 4B → 이동 범위 검사&lt;br&gt;② SyncRead 64~70  토크 · HW 에러 7B&lt;br&gt;③ SyncRead 98  워치독 1B" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;rounded=0;" vertex="1" parent="1"><mxGeometry x="880" y="480" width="360" height="96" as="geometry"/></mxCell>
<mxCell id="p1_R6" value="writeSpeed()  — 요청이 바뀐 경우만&lt;br&gt;SyncWrite 112~119&lt;br&gt;(Profile Velocity + Goal Position 8B)&lt;br&gt;→ SyncRead 112로 되읽어 검증" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;rounded=0;" vertex="1" parent="1"><mxGeometry x="880" y="600" width="360" height="86" as="geometry"/></mxCell>
